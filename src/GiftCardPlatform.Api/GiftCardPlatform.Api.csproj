<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!--
      Identifier for the local user-secrets store. Not a secret: it only names
      the folder under %APPDATA%\Microsoft\UserSecrets where development values
      live, outside the repository. Development configuration such as the SMTP
      password is set with `dotnet user-secrets set`, never committed here.
    -->
    <UserSecretsId>giftcard-platform-api-b46ca472-02fc-503a-bf02-83ccb2f4e363</UserSecretsId>
  </PropertyGroup>

