{
  "Distribution": {
    "ClaimBaseUrl": "http://localhost:5180/activate"
  },
  "Notifications": {
    "DispatchPollIntervalSeconds": 5,
    "Smtp": {
      "//": "Enabled stays false here so a fresh clone and CI start without a secret. Turn it on per machine with: dotnet user-secrets set \"Notifications:Smtp:Enabled\" \"true\"",
      "Enabled": false,
      "Host": "smtp.gmail.com",
      "Port": 587,
      "UseStartTls": true,
      "FromAddress": "developer@example.test",
      "FromDisplayName": "Gift Card Platform"
    }
  },
  "Sharing": {
    "ClaimBaseUrl": "http://localhost:5180/share/claim",
    "DirectClaimBaseUrl": "http://localhost:5180/activate/share"
  },
  "Partners": {
    "ClaimBaseUrl": "http://localhost:5180/epin"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  }
}
