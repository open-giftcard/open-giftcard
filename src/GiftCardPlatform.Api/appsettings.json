{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "GiftCards": {
    "Expiration": {
      "Enabled": true,
      "PollIntervalSeconds": 30,
      "BatchSize": 50
    }
  },
  "Distribution": {
    "BulkBatches": {
      "Enabled": true,
      "PollIntervalSeconds": 5,
      "ChunkSize": 25
    }
  },
  "Audit": {
    "Checkpoints": {
      "Enabled": false,
      "Provider": "DevelopmentFile",
      "PollIntervalSeconds": 300,
      "BatchSize": 10000
    }
  },
  "Networking": {
    "ForwardedHeaders": {
      "KnownProxies": []
    }
  },
  "Observability": {
    "Metrics": {
      "Enabled": false,
      "OtlpEndpoint": "http://127.0.0.1:4318/",
      "ExportIntervalSeconds": 15
    }
  },
  "AllowedHosts": "*"
}
