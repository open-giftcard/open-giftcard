# Normalise text in the repository, and check these out with LF regardless of
# platform. A shell script with a BOM or CRLF is not executable on Linux: the
# kernel reads the BOM as part of the interpreter path and fails with
# "No such file or directory" naming the shebang itself, which is what happened
# to the PostgreSQL init script the first time it ever ran in a container.
* text=auto

*.sh text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows-only tooling stays CRLF.
*.ps1 text eol=crlf
