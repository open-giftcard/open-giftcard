# Copy to .env for local development:  cp .env.example .env
# .env is git-ignored and must never be committed.
# These are local development placeholders only — never reuse them anywhere else.

POSTGRES_DB=giftcard
POSTGRES_PORT=5432

# Superuser: used only for one-time local setup and the disposable test database.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change_me_locally

# Migration owner (ADR-019): owns schemas and migrations, never used at runtime.
POSTGRES_MIGRATOR_USER=giftcard_migrator
POSTGRES_MIGRATOR_PASSWORD=change_me_locally

# Runtime application role (ADR-019): non-superuser, NOBYPASSRLS, DML only,
# and no UPDATE/DELETE on audit records.
POSTGRES_APP_USER=giftcard_app
POSTGRES_APP_PASSWORD=change_me_locally

# ---------------------------------------------------------------------------
# Application / tooling connection strings.
# The API reads ConnectionStrings__Default; nothing is committed in appsettings.
# ---------------------------------------------------------------------------
ConnectionStrings__Default=Host=localhost;Port=5432;Database=giftcard;Username=giftcard_app;Password=change_me_locally
Authentication__Jwt__SigningKey=change_me_locally_to_a_random_value_at_least_32_bytes
Bootstrap__PlatformAdministrator__Secret=change_me_locally_to_a_random_value_at_least_32_bytes

# E-pin reseller minting (PARTNER-001). The delivery key is startup-validated
# as a Base64-encoded 256-bit secret and has no default, so the API will not
# start without it. Generate 32 random bytes and Base64-encode them.
# Keep it stable while an idempotent mint retry may need to reproduce the same
# buyer link and PIN.
Partners__EpinDeliveryKey=Y2hhbmdlX21lX2xvY2FsbHlfYmVmb3JlX2FueV91c2U=
Partners__ClaimBaseUrl=http://localhost:5180/epin

# Optional: trust exactly one X-Forwarded-For hop from the cardholder BFF.
# Add only the immediate proxy's literal IP address. Leave unset for direct API use.
# Networking__ForwardedHeaders__KnownProxies__0=127.0.0.1

# Used by `dotnet ef` — migrations run as the migration owner, never the app role.
GIFTCARD_MIGRATIONS_CONNECTION=Host=localhost;Port=5432;Database=giftcard;Username=giftcard_migrator;Password=change_me_locally
